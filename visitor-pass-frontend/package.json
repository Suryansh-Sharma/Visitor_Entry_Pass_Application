{
  "name": "visitor-pass-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "@apollo/client": "^3.7.16",
    "@stomp/stompjs": "^7.3.0",
    "antd": "^6.4.4",
    "axios": "^1.7.7",
    "bootstrap": "^5.3.3",
    "electron-log": "^5.2.2",
    "graphql": "^16.9.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-bootstrap": "^2.8.0",
    "react-calendar": "^4.3.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.9.0",
    "react-router": "^6.13.0",
    "react-router-dom": "^6.13.0",
    "react-toastify": "^9.1.3",
    "react-webcam": "^7.1.1",
    "sockjs-client": "^1.6.1",
    "sweetalert2": "^11.14.5",
    "sweetalert2-react-content": "^5.0.7",
    "tree-kill": "^1.2.2"
  },
  "scripts": {
    "vite:dev": "vite",
    "electron:start": "cross-env NODE_ENV=development concurrently \"npm run vite:dev\" \"electron . --no-sandbox\"",
    "backend:build": "cd ../spring-visitor-entry && mvn -DskipTests package",
    "build": "vite build",
    "electron:build": "npm run backend:build && cross-env NODE_ENV=production npm run build && electron-builder",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^3.0.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.visitorpass.frontend",
    "productName": "Visitor-Entry-Pass",
    "files": [
      "dist/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "extraResources": [
      {
        "from": "../spring-visitor-entry/target/spring-visitor-entry-0.0.1-SNAPSHOT.jar",
        "to": "backend/spring-visitor-entry-0.0.1-SNAPSHOT.jar"
      },
      {
        "from": "public/assets",
        "to": "assets",
        "filter": ["**/*"]
      },
      {
        "from": "public/extraResources/jre",
        "to": "jre",
        "filter": ["**/*"]
      }
    ]
  }
}
